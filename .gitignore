## -----------------------------------------------
##  .gitignore for ASP.NET Core / C# project
## -----------------------------------------------

# ===== Visual Studio cache & config =====
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
.vscode/

# ===== Build output =====
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
publish/

# ===== NuGet =====
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# ===== ASP.NET Core =====
# Secrets & environment files
appsettings.Development.json
appsettings.*.json
!appsettings.json
*.pfx
*.p12

# ===== Entity Framework =====
# (keep migration .cs files, ignore nothing extra here)

# ===== Rider / JetBrains =====
.idea/
*.sln.iml

# ===== OS generated =====
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ===== Test results =====
TestResults/
*.trx
*.coverage
*.coveragexml

# ===== Publish profiles =====
**/Properties/PublishProfiles/
PublishScripts/
